DATABASE_URL="file:./dev.db"
AUTH_SECRET="folio-dev-secret-change-me-32chars"

# 本地默认是 SQLite 文件，不用改。线上换成托管 Postgres 给的地址，并看 docs/DEPLOY_PRODUCTION.md。
# 已在环境里设置的变量优先于这个文件。DATABASE_PROVIDER 可强制指定 sqlite 或 postgresql；不填则看 DATABASE_URL。
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/folio?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/folio?sslmode=require"
# DATABASE_PROVIDER="postgresql"

# 图片存在哪。local 写到 public/uploads，是默认值。无持久磁盘的部署改成 s3。
IMAGE_STORAGE="local"

# 只有 IMAGE_STORAGE=s3 时才需要。S3_ENDPOINT 是兼容接口地址，不要带桶名。
# S3_PUBLIC_BASE_URL 是浏览器能直接打开的图片前缀，可以是桶的公开域名或 CDN。
# S3_REGION="auto"
# S3_BUCKET="folio-images"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://images.example.com"
