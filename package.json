{
  "name": "folio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-env.cjs && next dev",
    "build": "node scripts/ensure-env.cjs && next build",
    "start": "node scripts/ensure-env.cjs && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/ensure-env.cjs && prisma db push && tsx prisma/seed.ts && playwright test",
    "db:push": "node scripts/ensure-env.cjs && prisma db push",
    "db:seed": "node scripts/ensure-env.cjs && tsx prisma/seed.ts",
    "db:reset": "node scripts/ensure-env.cjs && rm -f prisma/dev.db prisma/dev.db-journal && prisma db push && tsx prisma/seed.ts",
    "setup": "node scripts/ensure-env.cjs && prisma generate && prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "jose": "6.1.3",
    "lucide-react": "0.554.0",
    "next": "15.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
